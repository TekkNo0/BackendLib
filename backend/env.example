# Opción 1 (Easypanel / producción): URL completa con driver asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:tu_password_aqui@localhost:5432/libreria

# Opción 2 (desarrollo local por variables separadas si no se define DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_aqui
POSTGRES_DB=libreria
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Pool de Conexiones
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SQL_ECHO=false

# Seguridad y Autenticación
SECRET_KEY=clave_secreta_super_segura_para_firmar_tokens_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
